# RevenueCat public Test Store SDK key for the Android debug/demo build.
# Create a RevenueCat project + Test Store, then use its public SDK key here.
# Never use a secret RevenueCat REST API key in a client app.
VITE_REVENUECAT_API_KEY=your_test_store_public_sdk_key

# Entitlement attached to the Test Store product/offering.
VITE_RC_ENTITLEMENT_ID=pro_insights
